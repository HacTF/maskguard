{
  "manifest_version": 3,
  "name": "MaskGuard - 页面敏感数据脱敏",
  "short_name": "MaskGuard",
  "version": "1.0.0",
  "description": "按自定义正则或手动指定位置，自动识别并遮盖网页中的敏感数据。",
  "minimum_chrome_version": "100",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "panel.html",
    "default_title": "MaskGuard - 页面敏感数据脱敏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "panel.html?full=1",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*/*.pdf", "*://*/*.json"],
      "js": ["masker.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
